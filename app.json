{
  "expo": {
    "name": "TreNote",
    "locales": {
      "ja": "./locales/ja.json"
    },
    "slug": "gym-tracker",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymtracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/63f2d7a0-124d-4187-92f7-911a1a1733d5",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "ワークアウト中の心拍数および消費カロリーデータを表示・記録するためにヘルスケアデータにアクセスします。",
        "NSHealthUpdateUsageDescription": "ワークアウトデータをヘルスケアに記録するためにアクセスします。"
      }
    },
    "android": {
      "package": "com.gekirennomad.trenote",
      "versionCode": 36,
      "minSdkVersion": 26,
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_BASAL_METABOLIC_RATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      "./withAndroidAssets",
      "./withAndroidWidget",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4facfe",
          "defaultChannel": "rest-timer",
          "sounds": []
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "toshidiyilgmailcom",
          "project": "gym-tracker"
        }
      ],
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "フォトライブラリから食事の写真を選択するためにアクセスします。",
          "cameraPermission": "食事の写真を撮影してAI栄養解析するためにカメラを使用します。"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63f2d7a0-124d-4187-92f7-911a1a1733d5"
      }
    },
    "owner": "gekirennomads-organization"
  }
}
