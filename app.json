{
  "expo": {
    "name": "TreNote",
    "locales": {
      "ja": "./locales/ja.json"
    },
    "slug": "gym-tracker",
    "version": "1.0.11",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymtracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/63f2d7a0-124d-4187-92f7-911a1a1733d5",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": "1.0.11",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gekirennomad.trenote",
      "versionCode": 11,
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./withAndroidAssets",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4facfe",
          "defaultChannel": "rest-timer",
          "sounds": []
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "toshidiyilgmailcom",
          "project": "gym-tracker"
        }
      ],
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63f2d7a0-124d-4187-92f7-911a1a1733d5"
      }
    },
    "owner": "gekirennomads-organization"
  }
}
